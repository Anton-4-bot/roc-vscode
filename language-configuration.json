{
	"comments": {
		"lineComment": "#"
	},
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] }
	],
	"autoCloseBefore": ";:.,=}])> \n\t",
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"]
	],
	"wordPattern": "(-?\\d+(?:\\.\\d+)?(?:[eE][-+]?\\d+)?(?:\\.?[A-Za-z][A-Za-z0-9]*)?)|(\\$?[A-Za-z_][A-Za-z0-9_]*!?)",
	"indentationRules": {
		"increaseIndentPattern": "^((?!#).)*((?<![=!<>])=|->|=>|[\\{\\[\\(]|\\|[^|]*\\||\\belse)\\s*(#.*)?$",
		"decreaseIndentPattern": "^\\s*([\\}\\]\\)]|else\\b)"
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*##(\\s.*)?$",
			"action": { "indent": "none", "appendText": "## " }
		}
	],
	"folding": {
		"offSide": true
	}
}
